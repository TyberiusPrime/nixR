done
exec "$real_h5cc" "\$@"
EOF
  chmod +x "$TMPDIR/h5shim/h5cc"
  export H5CC="$TMPDIR/h5shim/h5cc"
  export PATH="$TMPDIR/h5shim:$PATH"
''
;
